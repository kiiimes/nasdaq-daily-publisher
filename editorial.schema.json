{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily Nasdaq editorial (source-checked agent input)",
  "type": "object",
  "required": [
    "trade_date",
    "kst_briefing_date",
    "reviewed",
    "headline",
    "subheadline",
    "summary",
    "up",
    "down",
    "korea",
    "sources",
    "crosscheck"
  ],
  "properties": {
    "headline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "subheadline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "trade_date": {
      "type": "string",
      "pattern": "^[0-9]{8}$"
    },
    "kst_briefing_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "reviewed": {
      "const": true,
      "description": "Source checked by scheduled agent, not human approval; not automated factual verification."
    },
    "up": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "symbol",
          "name",
          "change_pct",
          "tag",
          "why",
          "source_ids"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tag": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "change_pct": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              }
            ]
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "business": {
            "type": "string",
            "maxLength": 24
          }
        }
      }
    },
    "down": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "symbol",
          "name",
          "change_pct",
          "tag",
          "why",
          "source_ids"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tag": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "change_pct": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              }
            ]
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "business": {
            "type": "string",
            "maxLength": 24
          }
        }
      }
    },
    "korea": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "title",
          "body"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "supports"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "supports": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "crosscheck": {
      "type": "object",
      "required": [
        "COMP",
        "SPX",
        ".DJI"
      ],
      "additionalProperties": false,
      "properties": {
        "COMP": {
          "type": "object",
          "required": [
            "date",
            "close",
            "change_pct",
            "source_ids"
          ],
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^[0-9]{8}$"
            },
            "close": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                }
              ]
            },
            "change_pct": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                }
              ]
            },
            "source_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "SPX": {
          "type": "object",
          "required": [
            "date",
            "close",
            "change_pct",
            "source_ids"
          ],
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^[0-9]{8}$"
            },
            "close": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                }
              ]
            },
            "change_pct": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                }
              ]
            },
            "source_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        ".DJI": {
          "type": "object",
          "required": [
            "date",
            "close",
            "change_pct",
            "source_ids"
          ],
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^[0-9]{8}$"
            },
            "close": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                }
              ]
            },
            "change_pct": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                }
              ]
            },
            "source_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "hashtags": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "pattern": "^#\\w+$"
      }
    },
    "focus": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "body",
          "source_ids"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 35
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
